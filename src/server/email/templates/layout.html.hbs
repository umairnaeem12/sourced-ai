<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{subject}}</title>
  </head>
  <body style="margin:0;padding:0;background:#f6f5f1;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;color:#121417;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f6f5f1;padding:24px 12px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border:1px solid #e3e0d8;border-radius:16px;">
            <tr>
              <td style="padding:18px 24px;border-bottom:1px solid #e3e0d8;font-size:15px;font-weight:600;">
                <span style="display:inline-block;width:22px;height:22px;line-height:22px;text-align:center;border-radius:7px;background:#0d7c72;color:#ffffff;font-size:12px;">&#10022;</span>
                &nbsp;Sourced <span style="color:#0d7c72;font-style:italic;font-weight:400;">AI</span>
              </td>
            </tr>
            <tr>
              <td style="padding:24px;font-size:14px;line-height:1.6;">
                {{> @partial-block}}
              </td>
            </tr>
            <tr>
              <td style="padding:16px 24px;border-top:1px solid #e3e0d8;font-size:12px;color:#8b9099;">
                Sent by Sourced AI for {{storeName}}.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
