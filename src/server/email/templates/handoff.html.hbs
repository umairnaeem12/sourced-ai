{{#> layout}}
<h1 style="margin:0 0 6px;font-size:20px;line-height:1.3;">A customer asked for a person</h1>
<p style="margin:0 0 20px;color:#595f6a;">On {{storeName}}, {{askedAt}}.</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 20px;border:1px solid #e3e0d8;border-radius:12px;">
  <tr>
    <td style="padding:10px 14px;color:#595f6a;width:40%;">Reply to</td>
    <td style="padding:10px 14px;">{{#if email}}<a href="mailto:{{email}}" style="color:#0d7c72;">{{email}}</a>{{else}}No email left{{/if}}</td>
  </tr>
  <tr>
    <td style="padding:10px 14px;color:#595f6a;border-top:1px solid #e3e0d8;">Questions asked</td>
    <td style="padding:10px 14px;border-top:1px solid #e3e0d8;">{{questionCount}}</td>
  </tr>
  <tr>
    <td style="padding:10px 14px;color:#595f6a;border-top:1px solid #e3e0d8;">Not answered</td>
    <td style="padding:10px 14px;border-top:1px solid #e3e0d8;">{{unansweredCount}}</td>
  </tr>
</table>

{{#each conversation}}
<div style="margin:0 0 14px;">
  <p style="margin:0 0 4px;font-size:12px;color:#8b9099;">Customer</p>
  <p style="margin:0 0 10px;padding:10px 14px;background:#d8efea;border-radius:12px;">{{question}}</p>
  <p style="margin:0 0 4px;font-size:12px;color:#8b9099;">Sourced AI{{#unless is_answered}} <span style="color:#9a4b07;">(not answered)</span>{{/unless}}</p>
  <p style="margin:0;padding:10px 14px;background:#f6f5f1;border-radius:12px;">{{answer_text}}</p>
</div>
{{/each}}

<p style="margin:24px 0 0;">
  <a href="{{inboxUrl}}" style="display:inline-block;padding:10px 18px;background:#0d7c72;color:#ffffff;border-radius:999px;text-decoration:none;font-weight:600;">Open the inbox</a>
</p>
{{#if email}}<p style="margin:12px 0 0;font-size:12px;color:#8b9099;">Reply to this email to answer the customer directly.</p>{{/if}}
{{/layout}}
