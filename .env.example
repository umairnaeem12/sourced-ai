# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Which AI writes answers: gemini | groq | openai | anthropic
AI_PROVIDER=gemini

# Free key: https://aistudio.google.com (also used for embeddings, always required)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Free key: https://console.groq.com. Optional; used automatically when Gemini is rate limited.
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Only when AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=

# Only when AI_PROVIDER=anthropic (Claude)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Neon Postgres connection string (free project at https://neon.tech)
DATABASE_URL=

# Passages scoring below this are ignored (0 to 1). Tune with npm run smoke.
# MIN_SIMILARITY=0.55

# Questions per day across all visitors, to stay inside free-tier AI quotas.
# DAILY_QUESTION_LIMIT=500

# Where "Talk to a person" handoffs are announced, as a comma list: slack, email, webhook.
# Empty: handoffs only appear in the admin inbox (/admin/handoffs).
HANDOFF_NOTIFY=

# slack: incoming webhook (https://hooks.slack.com/services/...)
SLACK_WEBHOOK_URL=

# email: sent with Resend (https://resend.com). The free plan delivers only to your own
# signup address. Without RESEND_API_KEY in development, the email is written to the server log.
RESEND_API_KEY=
HANDOFF_EMAIL_TO=
# HANDOFF_EMAIL_FROM=onboarding@resend.dev   (Resend's test sender; use a verified domain in production)
# HANDOFF_EMAIL_FROM_NAME=Sourced AI

# webhook: POSTs a signed JSON "handoff.created" event, e.g. to n8n, Make, Zapier, Teams or Discord.
HANDOFF_WEBHOOK_URL=
# Signs the body as X-Sourced-Signature: sha256=<hmac>. Recommended.
HANDOFF_WEBHOOK_SECRET=

# Time zone for the admin charts (IANA name).
# STORE_TIMEZONE=America/New_York

# Any long random string. The e2e suite sends it so its questions and handoffs stay
# out of the admin reports. Leave empty to treat every request as a real visitor.
E2E_TRAFFIC_TOKEN=

# Public address of the app, used for links in notifications.
# APP_URL=http://localhost:3100

# Password for /admin (gap report, handoffs). At least 6 characters; unset disables admin.
ADMIN_PASSWORD=

# true: anyone can open and change the admin dashboard without the password, and /demo links to it.
# For a public portfolio demo only. Leave empty for a real store.
ADMIN_PUBLIC=
